<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:http="http://www.mulesoft.org/schema/mule/http"
	xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
	xmlns="http://www.mulesoft.org/schema/mule/core"
	xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd
http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd">
	<flow name="design-datamappingFlow"
		doc:id="6b4de137-576b-4ba3-9b2a-388069875402">
		<flow-ref doc:name="Flow Reference"
			doc:id="8b78d2bb-81fd-414f-bfb1-ceefd152c3ca"
			name="agent-api-continue-conversation" target="dataMappingResp" />
		<ee:transform doc:name="Transform Message"
			doc:id="13a39a06-8d49-4d47-880c-d2ee1ebaa9be">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	"sessionId": vars.dataMappingResp.sessionId,
	"analysis": read(vars.dataMappingResp.analysis, 'application/json')
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
		<ee:transform doc:name="Transform Message" doc:id="cc9a06fc-c354-4904-8d11-0cc98f3631dd" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
    "sessionId": payload.sessionId,
    "analysis": payload.analysis mapObject {
        ($$): $ map ((item, index) -> {
            "apiName": item.apiName,
            "layerName": item.layerName,
            "endpointName": item.endpointName,
            "method": item.method,
            "payload": item.'payload',
            //"flowDesign": item.flowDesign,
            "dataTransformation": item.dataTransformation replace "\n" with ""
        } )
    }
}]]></ee:set-payload>
			</ee:message>
		</ee:transform>
	</flow>
</mule>
